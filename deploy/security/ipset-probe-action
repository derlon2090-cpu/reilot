#!/bin/bash
set -euo pipefail

# Fail2ban passes only a parsed IP. Validate again before passing it to tools.
command=${1:-}
if [[ $command != start && $command != stop && $command != ban && $command != unban ]]; then exit 2; fi
if [[ $command == ban || $command == unban ]]; then
  ip=$(python3 -c 'import ipaddress,sys; print(ipaddress.ip_address(sys.argv[1]))' "${2:-}")
  if [[ $ip == *:* ]]; then setname=renvix_probe6; family=inet6; firewall=ip6tables
  else setname=renvix_probe4; family=inet; firewall=iptables; fi
else
  setname=''; family=''; firewall=''
fi

case "$command" in
  start)
    ipset create renvix_probe4 hash:ip family inet timeout 604800 maxelem 262144 -exist
    ipset create renvix_probe6 hash:ip family inet6 timeout 604800 maxelem 262144 -exist
    for pair in 'iptables renvix_probe4' 'ip6tables renvix_probe6'; do
      read -r fw setid <<< "$pair"
      "$fw" -w -C INPUT -m set --match-set "$setid" src -j DROP 2>/dev/null || "$fw" -w -I INPUT 1 -m set --match-set "$setid" src -j DROP
    done
    ;;
  stop)
    # Preserve the DROP rule and set if any entries remain: stopping Fail2ban
    # must not create a gap in containment. The next start is idempotent.
    ;;
  ban)
    ipset add "$setname" "$ip" timeout 604800 -exist
    ;;
  unban)
    ipset del "$setname" "$ip" -exist
    ;;
esac

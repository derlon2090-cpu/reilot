[honeypot-probes]
enabled = false
filter = honeypot-probes
logpath = /var/log/nginx/honeypot-probes.log
backend = auto
usedns = no
maxretry = 6
findtime = 60
bantime = 86400
bantime.increment = false
ignoreip = 127.0.0.1/8 ::1
# Direct host-managed Nginx only. Docker needs DOCKER-USER, see runbook.
action = iptables-allports[name=honeypot-probes, blocktype=DROP]
         probe-json
# For Cloudflare-proxied origins ADD this action, after installing its helper:
#         probe-cloudflare

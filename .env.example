# App
NEXT_PUBLIC_APP_NAME=Renvix
NEXT_PUBLIC_APP_URL=
APP_URL=https://renvix.app
AUTH_URL=
AUTH_SPLIT_HOST_ENABLED=true
AUTH_COOKIE_DOMAIN=
NODE_ENV=production

# Public URL of the Node.js authentication backend on Render (never a secret).
# Use a custom subdomain under renvix.app so the shared session cookie is valid.
NEXT_PUBLIC_API_BASE_URL=https://api.renvix.app

# Database - Neon
DATABASE_URL=
DIRECT_URL=

# Auth - Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Cloudflare Turnstile (public site key + server-only secret)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=accounts.renvix.app
# Temporary safe diagnostics: logs only success, error codes, hostname and action.
TURNSTILE_DIAGNOSTICS_ENABLED=false

# Google Identity Services
# Render/backend only. GOOGLE_CLIENT_ID is returned to the browser as the
# public OAuth identifier; GOOGLE_CLIENT_SECRET never leaves Render.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google already verifies email ownership. Enable only when policy requires an
# additional email code after Google (TOTP remains enforced when configured).
GOOGLE_EMAIL_OTP_REQUIRED=false
API_PUBLIC_URL=https://api.renvix.app
AUTH_BACKEND_RUNTIME=render

# WhatsApp - Evolution API self-hosted
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# WhatsApp - Meta Cloud API (server-only)
# Use the Graph API version approved for your Meta app, for example: vXX.X
META_GRAPH_API_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_APP_SECRET=

# Platform administrator messaging only (never used by tenant stores)
EVOLUTION_ADMIN_API_URL=
EVOLUTION_ADMIN_API_KEY=
EVOLUTION_ADMIN_INSTANCE=
EVOLUTION_ADMIN_WEBHOOK_URL=
EVOLUTION_ADMIN_WEBHOOK_SECRET=

# Email - Resend
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
NEXT_PUBLIC_META_WHATSAPP_CONNECT_URL=
RESEND_FROM_EMAIL=Renvix <noreply@renvix.app>
SUPPORT_EMAIL=support@renvix.app

# Payments - Moyasar
PAYMENT_PROVIDER=moyasar
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
MOYASAR_API_BASE_URL=https://api.moyasar.com/v1

# Security
JWT_SECRET=
CRON_SECRET=
ENCRYPTION_KEY=
ORDER_LINK_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY=

# File storage - Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Private admin console (server-only)
ADMIN_SETUP_TOKEN=
# Keep false in hosted environments. Enables tokenless first-admin setup only on loopback.
ADMIN_SETUP_ALLOW_LOCALHOST=false
# The login URL is /advanced-pro-control. ADMIN_EMAIL is used only by:
# ADMIN_EMAIL=user@renvix.app npm run admin:promote
ADMIN_EMAIL=

# Salla merchant integration (server-only)
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI=
SALLA_API_BASE_URL=https://api.salla.dev/admin/v2
SALLA_OAUTH_STATE_SECRET=
SALLA_WEBHOOK_SECRET=

# WhatsApp Safety Defaults
DEFAULT_SAFE_MODE_ENABLED=true
DEFAULT_DAILY_MESSAGE_LIMIT=100
DEFAULT_HOURLY_MESSAGE_LIMIT=20
DEFAULT_MIN_DELAY_SECONDS=20
DEFAULT_MAX_DELAY_SECONDS=90
DEFAULT_QUIET_HOURS_START=21:00
DEFAULT_QUIET_HOURS_END=09:00
DEFAULT_MAX_BLOCK_RISK_SCORE=70
# Optional permanent administrator bootstrap (keep the password outside Git).
ADMIN_BOOTSTRAP_EMAIL=admin@renvix.app
ADMIN_BOOTSTRAP_USERNAME=renvix_root_7X9K
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Renvix Admin
EMAIL_FROM=Renvix <noreply@notify.renvix.app>
EMAIL_OTP_PEPPER=
# Optional Argon2id secret kept in the hosting secret manager, never in Git.
# Use at least 32 random bytes. Rotation requires a documented reset/migration plan.
PASSWORD_PEPPER=
# Unified second factor: trusted browser -> TOTP -> email OTP.
AUTH_SECOND_FACTOR_REQUIRED=true
EMAIL_SIGNUP_OTP_REQUIRED=true
EMAIL_OTP_FALLBACK_ENABLED=true
TRUSTED_BROWSER_ENABLED=true
TRUSTED_BROWSER_HOURS=48
EMAIL_OTP_ENFORCE_ALL=false
CUSTOM_API_KEY_PEPPER=
CUSTOM_INTEGRATION_ENCRYPTION_KEY=
CUSTOM_API_RATE_LIMIT_PER_MINUTE=120

# Renvix Account Intelligence (server-only)
AI_ASSISTANT_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# Internal-only cost guard. Rates are micros per one million actual provider tokens.
AI_TENANT_MONTHLY_COST_GUARD_MICROS=
AI_FLASH_INPUT_COST_MICROS_PER_MILLION=
AI_FLASH_OUTPUT_COST_MICROS_PER_MILLION=
AI_FLASH_CACHE_HIT_COST_MICROS_PER_MILLION=
AI_PRO_INPUT_COST_MICROS_PER_MILLION=
AI_PRO_OUTPUT_COST_MICROS_PER_MILLION=
AI_PRO_CACHE_HIT_COST_MICROS_PER_MILLION=

# Private Cloudflare R2 attachments (server-only; bucket-scoped object read/write token)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=renvix-staging
# Optional when using an S3-compatible test endpoint
R2_ENDPOINT=

# Vision and speech provider variables are intentionally omitted until a
# concrete production provider and its real credential names are approved.

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run db:migrate && npm run db:verify-auth-schema && npm run build",
  "outputDirectory": ".next",
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://renvix.app",
    "APP_URL": "https://renvix.app",
    "AUTH_URL": "https://accounts.renvix.app",
    "AUTH_COOKIE_DOMAIN": ".renvix.app",
    "BETTER_AUTH_URL": "https://accounts.renvix.app",
    "COOKIE_SECURE": "true",
    "NODE_ENV": "production"
  },
  "crons": [
    {
      "path": "/api/cron/salla-webhook-worker",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/renewal-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/subscription-notifications",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/whatsapp-health-check",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/message-retry",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/usage-reset",
      "schedule": "5 0 1 * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/recalculate-security-scores",
      "schedule": "15 3 * * *"
    }
  ]
}

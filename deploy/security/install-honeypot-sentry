#!/bin/bash
set -Eeuo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "Run as root: sudo $0" >&2
  exit 1
fi

source_dir=$(cd -- "$(dirname -- "$0")" && pwd)
for command_name in ipset iptables ip6tables tail systemctl; do
  command -v "$command_name" >/dev/null || { echo "Missing dependency: $command_name" >&2; exit 1; }
done

install -m 0750 "$source_dir/honeypot-sentry" /usr/local/sbin/honeypot-sentry
install -m 0644 "$source_dir/renvix-honeypot-sentry.service" /etc/systemd/system/renvix-honeypot-sentry.service
install -m 0644 "$source_dir/honeypot-sentry.logrotate" /etc/logrotate.d/renvix-honeypot-sentry
install -d -m 0750 -o root -g root /var/log/renvix
install -d -m 0750 -o root -g adm /var/log/nginx
touch /var/log/nginx/honeypot-probes.log
chown root:adm /var/log/nginx/honeypot-probes.log
chmod 0640 /var/log/nginx/honeypot-probes.log

/usr/local/sbin/honeypot-sentry --setup
ipset add honeypot_blacklist 34.152.30.165 timeout 604800 -exist
ipset add honeypot_blacklist 34.52.133.111 timeout 604800 -exist
while read -r ip; do
  [[ -n $ip ]] || continue
  ipset add honeypot_blacklist "$ip" timeout 604800 -exist
done <<'EOF'
45.138.12.16
194.5.53.185
174.138.22.143
34.14.21.20
136.112.238.192
34.88.208.172
195.178.110.159
45.148.10.62
EOF
/usr/local/sbin/honeypot-sentry --save

systemctl daemon-reload
systemctl enable --now renvix-honeypot-sentry.service
systemctl --no-pager --full status renvix-honeypot-sentry.service

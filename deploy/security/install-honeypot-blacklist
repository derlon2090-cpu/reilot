#!/bin/bash
set -Eeuo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "Run as root: sudo $0" >&2
  exit 1
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ipset ipset-persistent iptables-persistent

set_name=honeypot_blacklist

# timeout support is enabled with a zero default so established incident
# sources remain permanent while a responder can add bounded entries safely.
# Upgrade an older set atomically; the iptables reference follows the set name
# across the swap and therefore never opens a firewall gap.
if ! ipset list "$set_name" >/dev/null 2>&1; then
  ipset create "$set_name" hash:ip family inet hashsize 1024 maxelem 65536 timeout 0
elif ! ipset save "$set_name" | sed -n '1p' | grep -Eq '(^|[[:space:]])timeout[[:space:]]+0([[:space:]]|$)'; then
  migration_set="hpbl_migrate_$$"
  trap 'ipset destroy "$migration_set" >/dev/null 2>&1 || true' EXIT
  ipset create "$migration_set" hash:ip family inet hashsize 1024 maxelem 65536 timeout 0
  while read -r operation saved_set saved_ip _; do
    [[ $operation == add && $saved_set == "$set_name" ]] || continue
    ipset add "$migration_set" "$saved_ip" timeout 0 -exist
  done < <(ipset save "$set_name")
  ipset swap "$set_name" "$migration_set"
  ipset destroy "$migration_set"
  trap - EXIT
fi

while read -r ip; do
  ipset add "$set_name" "$ip" timeout 0 -exist
done <<'EOF'
147.182.200.94
138.197.191.87
142.93.0.66
159.65.18.197
159.65.144.72
130.12.180.117
34.140.132.132
91.148.245.81
EOF

# INC-2026-000200: legacy WordPress manifest probe. Re-running this installer
# refreshes only this bounded entry; it does not convert permanent entries.
ipset add "$set_name" 185.19.40.179 timeout 604800 -exist

# No interface selector is used: every packet traversing INPUT is covered.
# DROP is intentionally silent (no REJECT, TCP RST, or ICMP response).
iptables -w -C INPUT -m set --match-set "$set_name" src -j DROP 2>/dev/null \
  || iptables -w -I INPUT 1 -m set --match-set "$set_name" src -j DROP

# Docker-published ports traverse FORWARD, not INPUT. Protect them when the
# standard Docker iptables chain exists, without creating a fake chain.
if iptables -w -nL DOCKER-USER >/dev/null 2>&1; then
  iptables -w -C DOCKER-USER -m set --match-set "$set_name" src -j DROP 2>/dev/null \
    || iptables -w -I DOCKER-USER 1 -m set --match-set "$set_name" src -j DROP
fi

tmp_ipset=$(mktemp /etc/ipset.conf.XXXXXX)
trap 'rm -f "$tmp_ipset"' EXIT
ipset save > "$tmp_ipset"
chmod 0600 "$tmp_ipset"
mv -f "$tmp_ipset" /etc/ipset.conf
trap - EXIT

netfilter-persistent save

ipset list "$set_name"
iptables -w -C INPUT -m set --match-set "$set_name" src -j DROP
if iptables -w -nL DOCKER-USER >/dev/null 2>&1; then
  iptables -w -C DOCKER-USER -m set --match-set "$set_name" src -j DROP
fi
ipset test "$set_name" 185.19.40.179
echo "Silent DROP installed: 8 permanent sources and INC-2026-000200 for 7 days."

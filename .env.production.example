NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Renvix
NEXT_PUBLIC_APP_URL=https://renvix.app
APP_URL=https://renvix.app
AUTH_URL=
AUTH_SPLIT_HOST_ENABLED=false
AUTH_COOKIE_DOMAIN=
NEXT_PUBLIC_API_BASE_URL=https://api.renvix.app

POSTGRES_USER=renewpilot
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=renewpilot
DATABASE_URL=postgresql://renewpilot:replace-with-a-long-random-password@database:5432/renewpilot
DATABASE_SSL=false

BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=https://accounts.renvix.app
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=accounts.renvix.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_PUBLIC_URL=https://api.renvix.app
AUTH_BACKEND_RUNTIME=render
JWT_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-32-byte-secret
ORDER_LINK_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
MFA_ENCRYPTION_KEY=replace-with-a-separate-32-byte-secret
META_GRAPH_API_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_APP_SECRET=
BLOB_READ_WRITE_TOKEN=

# Private admin console (server-only)
# Promote an existing real user once with npm run admin:promote.
ADMIN_EMAIL=

# Salla merchant integration (server-only)
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI=https://renvix.app/api/apps/salla/callback
SALLA_API_BASE_URL=https://api.salla.dev/admin/v2
SALLA_OAUTH_STATE_SECRET=replace-with-a-long-random-secret
SALLA_WEBHOOK_SECRET=

WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_URL=https://renvix.app/api/webhooks/evolution
EVOLUTION_PAIRING_CODE_SUPPORTED=true

# Platform administrator WhatsApp. When URL/key are left empty, the app safely
# reuses EVOLUTION_API_URL/EVOLUTION_API_KEY with a separate admin instance.
EVOLUTION_ADMIN_API_URL=
EVOLUTION_ADMIN_API_KEY=
EVOLUTION_ADMIN_INSTANCE=
EVOLUTION_ADMIN_WEBHOOK_URL=https://renvix.app/api/webhooks/evolution
EVOLUTION_ADMIN_WEBHOOK_SECRET=

EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Renvix <noreply@renvix.app>
EMAIL_OTP_PEPPER=
# Optional Argon2id secret kept in the hosting secret manager, never in Git.
# Use at least 32 random bytes. Rotation requires a documented reset/migration plan.
PASSWORD_PEPPER=
AUTH_SECOND_FACTOR_REQUIRED=true
EMAIL_SIGNUP_OTP_REQUIRED=true
EMAIL_OTP_FALLBACK_ENABLED=true
TRUSTED_BROWSER_ENABLED=true
TRUSTED_BROWSER_HOURS=48
EMAIL_OTP_ENFORCE_ALL=false
SUPPORT_EMAIL=support@renvix.app

# Renvix Account Intelligence (keep the key in the hosting secret manager)
AI_ASSISTANT_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

PAYMENT_PROVIDER=moyasar
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

DEFAULT_SAFE_MODE_ENABLED=true
DEFAULT_DAILY_MESSAGE_LIMIT=100
DEFAULT_HOURLY_MESSAGE_LIMIT=20
DEFAULT_MIN_DELAY_SECONDS=20
DEFAULT_MAX_DELAY_SECONDS=90
DEFAULT_QUIET_HOURS_START=21:00
DEFAULT_QUIET_HOURS_END=09:00
DEFAULT_MAX_BLOCK_RISK_SCORE=70
# Permanent administrator bootstrap. Store the password in the hosting secret manager.
ADMIN_SETUP_TOKEN=
ADMIN_BOOTSTRAP_ON_BUILD=false
ADMIN_BOOTSTRAP_EMAIL=admin@renvix.app
ADMIN_BOOTSTRAP_USERNAME=renvix_root_7X9K
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Renvix Admin

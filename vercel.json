{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://renvix.app",
    "SITE_URL": "https://renvix.app",
    "NEXT_PUBLIC_AUTH_URL": "https://accounts.renvix.app",
    "AUTH_URL": "https://accounts.renvix.app",
    "NEXT_PUBLIC_APP_URL": "https://dash.renvix.app",
    "APP_URL": "https://dash.renvix.app",
    "NEXT_PUBLIC_ADMIN_URL": "https://wa-admin.renvix.app",
    "ADMIN_URL": "https://wa-admin.renvix.app",
    "HONEYPOT_PUBLIC_URL": "https://admin.renvix.app",
    "AUTH_COOKIE_DOMAIN": ".renvix.app",
    "BETTER_AUTH_URL": "https://accounts.renvix.app",
    "NEXT_PUBLIC_API_BASE_URL": "https://api.renvix.app",
    "API_PUBLIC_URL": "https://api.renvix.app",
    "COOKIE_SECURE": "true",
    "NODE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.renvix.app/api/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/salla-webhook-worker",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/renewal-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/subscription-notifications",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/whatsapp-health-check",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/message-retry",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/usage-reset",
      "schedule": "5 0 1 * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/recalculate-security-scores",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/security-inspector",
      "schedule": "7 4 * * *"
    }
  ]
}
